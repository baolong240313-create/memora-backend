# Copy this file to `.env` and fill in your values. Memora loads it on startup.
# (Every value here is optional; the app falls back to safe defaults.)

# ---- Session / security ----
# A long random string used to sign cookies (sessions, guest limit).
# If unset, Memora generates and persists one at ~/.memora-data/secret.key so
# users aren't logged out on restart.
#MEMORA_SECRET=change-me-to-a-long-random-string

# Path to the SQLite database file.
#MEMORA_DB=

# ---- AI flashcard generation (optional) ----
#GEMINI_API_KEY=your-gemini-api-key
#GEMINI_MODEL=gemini-2.5-flash

# ---- Google sign-in (optional) ----
# Get a Web-application OAuth 2.0 Client ID from the Google Cloud Console.
# See README: Google sign-in setup.
#GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ---- SMTP for password-reset emails (optional) ----
# To send real reset emails, set these. Example for Gmail:
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-16-char-app-password
#SMTP_FROM=Memora <you@gmail.com>